# ─────────────────────────────────────────────────────────────
# TIENDA COLMENA — Variables de entorno
# ─────────────────────────────────────────────────────────────
# INSTRUCCIONES:
#   1. Copia este archivo y renómbralo a ".env"  (sin el .example)
#   2. Rellena los valores según tu entorno
#   3. NUNCA subas el archivo .env a GitHub (ya está en .gitignore)
#   4. En Vite, todas las variables DEBEN empezar con VITE_
#      para ser accesibles desde el código React.
# ─────────────────────────────────────────────────────────────

# URL base de tu API Node/Express
# Desarrollo local:
VITE_API_URL=http://localhost:3000/api
# Producción (cuando despliegues):
# VITE_API_URL=https://tu-dominio.com/api

# Nombre de la app (opcional, para mostrar en UI o logs)
VITE_APP_NAME=Tienda Colmena
# true = usa los datos de ejemplo (src/data/products.js)
# false = usa la API real de VITE_API_URL
VITE_USE_MOCK=true